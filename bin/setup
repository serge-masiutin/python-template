#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ ! -f .env ]]; then
  umask 077
  uv run --no-project python -c 'from pathlib import Path; import secrets; Path(".env").write_text(Path(".env.example").read_text().replace("generate-with-bin-setup", secrets.token_urlsafe(48)))'
fi
uv sync --frozen
npm ci
docker compose up -d --wait db
npm run build
bin/manage migrate
