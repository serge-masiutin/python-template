+```python
+@contextmanager
+def timed_operation(name, metrics):
+    started = time.perf_counter()
+    try:
+        yield
+    finally:
+        metrics.observe_duration(name, time.perf_counter() - started)
+# The metric name is a bounded constant chosen by the caller.
